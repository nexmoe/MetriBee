<!doctype html>
<html lang="en" class="dark" style="color-scheme: dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Your Google Analytics 4 reports, in one workspace." />
  <title>{{title}}</title>
  <link rel="icon" href="/logo.png" />
  <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
  <script>try{const p=new URLSearchParams(location.search);const e=p.get('embed')==='true';const t=e?(p.get('theme')||'system'):(localStorage.getItem('pb_theme')||'dark');const dark=t==='dark'||t==='system'&&matchMedia('(prefers-color-scheme: dark)').matches;document.documentElement.classList.toggle('dark',dark);document.documentElement.style.colorScheme=dark?'dark':'light'}catch(e){}</script>
  {{#each styles}}<link rel="stylesheet" href="{{this}}" />{{/each}}
</head>
<body class="bg-background text-foreground h-full">
  {{#if demo}}<!-- Demo data: generated reports, no Google requests. -->{{/if}}
  <div id="root">{{#if setup}}<main class="mx-auto max-w-3xl p-6"><h1 class="text-2xl font-semibold">Connect Google Analytics</h1><p id="ai" class="mt-3 text-sm text-neutral-500" aria-busy="true">Loading connection instructions…</p></main>{{/if}}</div>
  <noscript>This analytics workspace needs JavaScript. Enable it, then reload the page.</noscript>
  <script>window.__GA4_CONTEXT__={{{json_stringify bootstrap}}};</script>
  <script type="module" src="{{script}}"></script>
</body>
</html>
