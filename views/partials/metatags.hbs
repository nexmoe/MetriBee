<meta name='msapplication-config' content='/icons/browserconfig.xml' /> }}
<meta name='theme-color' content='#ffffff' />

{{! Meta Tags }}
<title>{{title}}</title>
<meta name='description' content='{{description}}' />
{{! // TODO: add some other meta tags if needed and some logic if any important value is not present then what to use }}
<!--facebook share-->
<meta property='og:image' content='{{#if image}}{{image}}{{else}}/og.png{{/if}}' />
<meta property='og:type' content='website' />
{{#if url}}
    <meta property='og:url' content='{{url}}' />
{{/if}}

<meta property='og:title' content='{{title}}' />
{{! site name }}
<meta property='og:site_name' content='MetriBee' />
<meta property='og:description' content='{{description}}' />

<!--twitter：card share-->
<meta name='twitter:title' content='{{title}}' />
<meta name='twitter:description' content='{{description}}' />
<meta name='twitter:image' content='{{#if image}}{{image}}{{else}}/og.png{{/if}}' />
<meta name='twitter:card' content='summary_large_image' />
{{! <meta name="twitter:site" content="@flickr" /> }}

