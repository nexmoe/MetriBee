# Service account email from the JSON key (client_email). Setup steps: SETUP.md or the /setup page.
GA4_CLIENT_EMAIL=
# Private key from the JSON key (private_key). Keep the double quotes and the \n sequences.
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional real multi-step Journeys from GA4 BigQuery export. Leave unset until export is enabled.
# Dataset is always analytics_<property ID>. Location must match the dataset (US, EU or a region).
# GA4_BIGQUERY_SOURCES={"123456789":{"projectId":"my-ga4-project","location":"US"}}
# Optional billingProjectId on each mapping overrides the query billing project.
# Reuses GA4 service-account credentials through a separate BigQuery client; optional separate account:
# BIGQUERY_CLIENT_EMAIL=
# BIGQUERY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Hard query cap and per-billing-project UTC-day application budgets (bytes / query jobs).
# BIGQUERY_MAX_BYTES_BILLED=1073741824
# BIGQUERY_DAILY_BYTES=10737418240
# BIGQUERY_DAILY_QUERIES=100

# Optional Google Search Console service account (webmasters.readonly).
# Reuse an existing account with access to your GSC sites; values stay in env, never a key file.
# GSC_CLIENT_EMAIL=
# GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional fallback only when GA4 provides no website URL:
# GSC_WEBSITE_URLS={"123456789":"https://example.com/"}

# Optional. Enables the run_pagespeed_insights MCP tool.
# PSI_API_KEY=
# Optional. Default 5483.
# PORT=5483

# Public browser origin. Required when using a reverse proxy or non-default port.
# BASE_URL=https://analytics.example.com
# Optional; otherwise a random stable auth secret is stored inside SQLite.
# BETTER_AUTH_SECRET=
# SQLite application database (users, sessions, organizations, teams, property grants, saved definitions).
# DATABASE_PATH=/app/.data/metribee.sqlite
# Set true after creating your first administrator to allow only invited registrations.
# DISABLE_SIGNUP=true
# Trust forwarding headers only when running behind your own trusted proxy.
# TRUST_PROXY=true
# Additional trusted browser origins, comma separated.
# AUTH_TRUSTED_ORIGINS=

# Optional website sign-in providers, independent of supplemental GA4 read access below.
# Redirect URIs: <BASE_URL>/api/auth/callback/google and <BASE_URL>/api/auth/callback/github.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Mail enables invitations, account recovery, property transfers and weekly reports.
# Cloudflare Email Sending: onboard your domain, then use a token with Email Sending: Edit.
# CLOUDFLARE_EMAIL_API_TOKEN=
# Or use Resend:
# RESEND_API_KEY=
# Or use any SMTP provider:
# SMTP_URL=smtps://user:password@smtp.example.com:465
# Alternatively set SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASSWORD.
# MAIL_FROM=MetriBee <analytics@example.com>
# Weekly reports run on Monday UTC when mail is configured; users can unsubscribe in Account settings.
# WEEKLY_REPORTS_ENABLED=false
# PDF export uses Chromium (included in the Docker image). For source installs:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# MCP is served by the dashboard at http://localhost:5483/mcp.
# Optional standalone server (pnpm mcp); independent of PORT/HOST.
# MCP_HOST=127.0.0.1
# MCP_PORT=5484
# For a reverse proxy, set only its public /mcp URL and restart the server.
# Its hostname is automatically allowed for Host and browser Origin validation.
# Localhost hosts/origins remain allowed. Requests without Origin are accepted.
# MCP_PUBLIC_URL=https://ga4.example.com/mcp
# Advanced: allow additional hostnames (comma-separated, no ports).
# MCP_ALLOWED_HOSTS=ga4.example.com
# MCP_ALLOWED_ORIGINS=ga4.example.com

# Optional supplemental Google user OAuth for properties the service account cannot access.
# See "Supplemental user OAuth" in SETUP.md. Leave unset to use only the service account.
# GA4_OAUTH_CLIENT_ID=
# GA4_OAUTH_CLIENT_SECRET=
# GA4_OAUTH_ACCOUNT_IDS=
# GA4_OAUTH_PROPERTY_IDS=
# Written by pnpm oauth:login after browser consent; never commit or paste this token.
# GA4_OAUTH_REFRESH_TOKEN=

# Self-hosted by default: no billing pages, payment endpoints or payment worker.
CLOUD=false
# Set CLOUD=true explicitly only for a MetriBee Cloud deployment.
# WAFFO_MODE=test
# WAFFO_MERCHANT_ID=MER_xxx
# WAFFO_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Only the merchant ID and private key are payment credentials. Catalog IDs live in SQLite.
