# Service account email from the JSON key (client_email). Setup steps: SETUP.md or the /setup page.
GA4_CLIENT_EMAIL=
# Private key from the JSON key (private_key). Keep the double quotes and the \n sequences.
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional Google Search Console service account (webmasters.readonly).
# Reuse an existing account with access to your GSC sites; values stay in env, never a key file.
# GSC_CLIENT_EMAIL=
# GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional fallback only when GA4 provides no website URL:
# GSC_WEBSITE_URLS={"123456789":"https://example.com/"}

# Optional. Enables the run_pagespeed_insights MCP tool.
# PSI_API_KEY=
# Optional. Default 5483.
# PORT=5483

# MCP is served by the dashboard at http://localhost:5483/mcp.
# Optional standalone server (pnpm mcp); independent of PORT/HOST.
# MCP_HOST=127.0.0.1
# MCP_PORT=5484
# For a reverse proxy, set only its public /mcp URL and restart the server.
# Its hostname is automatically allowed for Host and browser Origin validation.
# Localhost hosts/origins remain allowed. Requests without Origin are accepted.
# MCP_PUBLIC_URL=https://ga4.example.com/mcp
# Advanced: allow additional hostnames (comma-separated, no ports).
# MCP_ALLOWED_HOSTS=ga4.example.com
# MCP_ALLOWED_ORIGINS=ga4.example.com

# Optional supplemental Google user OAuth for properties the service account cannot access.
# See "Supplemental user OAuth" in SETUP.md. Leave unset to use only the service account.
# GA4_OAUTH_CLIENT_ID=
# GA4_OAUTH_CLIENT_SECRET=
# GA4_OAUTH_ACCOUNT_IDS=
# GA4_OAUTH_PROPERTY_IDS=
# Written by pnpm oauth:login after browser consent; never commit or paste this token.
# GA4_OAUTH_REFRESH_TOKEN=
