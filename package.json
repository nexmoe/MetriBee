{
  "name": "metribee",
  "version": "2.2.1",
  "description": "MetriBee: real-time Google Analytics 4 dashboard featuring 3D globe visualization, traffic spike detection, visitor insights, and an embedded MCP server.",
  "main": "app.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && pnpm build:ui",
    "css": "npx tailwindcss -i ./styles/main.scss -o ./public/css/main.css --watch",
    "start": "sh docker-entrypoint.sh node app.js",
    "demo": "DEMO=1 sh docker-entrypoint.sh node app.js",
    "test": "mocha --require ts-node/register/transpile-only test/**/*.test.js",
    "mcp": "sh docker-entrypoint.sh node mcp-server/index.js",
    "setup:check": "node scripts/setup-check.js",
    "oauth:login": "node scripts/oauth-login.js",
    "snapshot:sessions": "node scripts/snapshot-sessions.js",
    "import:funnels": "node scripts/import-funnels.js",
    "build:ui": "pnpm --filter @metribee/ui build",
    "dev:ui": "pnpm --filter @metribee/ui dev",
    "typecheck:ui": "pnpm --filter @metribee/ui typecheck",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:generate": "drizzle-kit generate --config=drizzle.config.js",
    "db:check-migrations": "drizzle-kit check --config=drizzle.config.js",
    "db:backup": "node scripts/database.mjs backup",
    "db:check": "node scripts/database.mjs check"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nexmoe/MetriBee.git"
  },
  "bugs": {
    "url": "https://github.com/nexmoe/MetriBee/issues"
  },
  "homepage": "https://github.com/nexmoe/MetriBee#readme",
  "author": "Nexmoe",
  "contributors": [
    "Amit Yadav (original GA4-Dashboard-MCP)"
  ],
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@better-auth/api-key": "1.7.3",
    "@better-auth/mcp": "1.7.3",
    "@better-auth/oauth-provider": "1.7.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.3.0",
    "@fastify/view": "^11.1.1",
    "@google-analytics/admin": "^9.2.0",
    "@google-analytics/data": "^6.1.0",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@react-email/components": "1.0.1",
    "@react-email/render": "^2.1.1",
    "@waffo/pancake-ts": "^0.26.0",
    "better-auth": "1.7.3",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.6.1",
    "drizzle-kit": "0.31.9",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.12.7",
    "google-auth-library": "^10.9.1",
    "handlebars": "^4.7.10",
    "ip-address": "^10.7.4",
    "luxon": "3.6.1",
    "nodemailer": "^7.0.13",
    "puppeteer-core": "^24.43.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldts": "^7.4.19",
    "tz-lookup": "^6.1.25",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/line-clamp": "^0.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^25.9.9",
    "c8": "^10.1.3",
    "chai": "^4.5.0",
    "mocha": "^12.0.2",
    "nodemon": "^3.1.14",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.1.13",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
